{
  "functions": {
    "src/app/api/**/*.{ts,tsx}": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily-content",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/weekly-plan",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/cron/content-decay",
      "schedule": "0 9 1 * *"
    },
    {
      "path": "/api/cron/analytics-digest",
      "schedule": "0 10 * * 1"
    }
  ]
}
